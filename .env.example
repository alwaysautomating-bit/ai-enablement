DATABASE_URL="file:./dev.db"

# Context Capture extraction model: anthropic | openai | recorded (sample data only).
# Without it, a configured provider is used, falling back to recorded.
# CONTEXT_EXTRACTOR="openai"

# Anthropic (defaults to claude-opus-5)
# ANTHROPIC_API_KEY=""
# CONTEXT_ANTHROPIC_MODEL="claude-opus-5"

# OpenAI (OPEN_AI_KEY is also accepted)
# OPENAI_API_KEY=""
# OPENAI_EXTRACTION_MODEL="gpt-5.5"

# Local development only: act as another sample user in the web app.
# AIEW_DEV_USER="user_marcus"

# MCP client token (create with: npm run context:token)
# AIEW_CLIENT_TOKEN=""
